/* Klaus Monitor TUI Styles - htop-inspired */

Screen {
    background: $surface;
    color: $text;
    overflow: hidden;
}

#header {
    dock: top;
    height: 2;
    background: $boost;
    color: $text;
    border: solid $primary;
}

#footer {
    dock: bottom;
    height: 1;
    background: $boost;
    color: $text-muted;
}

#container {
    layout: grid;
    grid-size: 3 2;
    grid-rows: 1fr 1fr 1fr;
    grid-columns: 1fr 2fr 1fr;
}

#stats-panel {
    border: solid $primary;
    border-title-align: left;
}

#traffic-panel {
    border: solid $primary;
    border-title-align: left;
    grid-column: 2;
    grid-row: 1 / 3;
}

#vault-panel {
    border: solid $primary;
    border-title-align: left;
    grid-column: 3;
    grid-row: 1 / 3;
}

#audit-panel {
    border: solid $primary;
    border-title-align: left;
    grid-column: 1 / 3;
    grid-row: 3;
}

#alerts-panel {
    border: solid $primary;
    border-title-align: left;
    grid-column: 3;
    grid-row: 3;
}

.request-ok {
    color: $success;
}

.request-pseudonymized {
    color: $accent;
}

.request-blocked {
    color: $warning;
}

.request-error {
    color: $error;
}

.stat-label {
    color: $text-muted;
    width: 15;
}

.stat-value {
    color: $accent;
    text-align: right;
}

.leak-alert {
    background: $error 20%;
    color: $error;
}

.success-indicator {
    color: $success;
}

.warning-indicator {
    color: $warning;
}

.error-indicator {
    color: $error;
}
